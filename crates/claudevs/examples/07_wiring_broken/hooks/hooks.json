{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/session-banner.sh\"" } ] }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/format-on-write.sh\"" } ]
      }
    ]
  }
}
